# Copy this file to .env and fill in your actual values.
# Never commit the real .env file to git.

PORT=5000
NODE_ENV=production

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=swittix_db
DB_USER=root
DB_PASSWORD=

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# Max upload size per file, in bytes (default 10MB)
MAX_FILE_SIZE=10485760

# Secret used to sign admin login tokens — keep this private, never commit it
JWT_SECRET=8f2a91e6c4b7d3f0a5e8c1b9d6f4a2e7c0b8d5f3a1e9c7b4d2f8a6e0c3b1d9f5